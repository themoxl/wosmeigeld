# Kopieren nach `.env` und anpassen. Diese Datei enthaelt keine echten Secrets.
# Siehe FINANZ_APP_ARCHITEKTURPLAN.md Abschnitt 2 (Architekturentscheidungen) und 4 (Docker-Topologie).
#
# Die SUPABASE_*-Werte unten sind die Standard-Demo-Zugangsdaten, die
# `supabase start` (Supabase CLI) fuer JEDES lokale Projekt gleich erzeugt -
# oeffentlich dokumentiert, kein echtes Secret. Fuer Staging/Produktion
# IMMER durch die echten, projektspezifischen Werte ersetzen.

# --- Allgemein -----------------------------------------------------------
ENVIRONMENT=development

# --- Web (apps/web, Vite) -------------------------------------------------
# Vom Browser aus erreichbare API-Basis-URL.
VITE_API_BASE_URL=http://localhost:8882
# Supabase Auth spricht der Client direkt an (Architekturplan Abschnitt 2:
# JWT wird nur durch die BFF-API validiert, nicht dort ausgestellt).
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# --- Mobile (apps/mobile, Expo) -------------------------------------------
# Fuer Expo Go / Simulator: Rechner-IP statt localhost verwenden, wenn auf
# einem echten Geraet getestet wird.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8882
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# --- API (services/api, FastAPI) ------------------------------------------
API_PORT=8882
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Standard-Dev-Weg (Abschnitt 4, Betriebsprofil "Development"): lokales
# Supabase per `supabase start` (siehe supabase/README.md). Von Docker-
# Containern aus ueber host.docker.internal erreichbar, wie bei LM Studio.
DATABASE_URL=postgresql+psycopg://postgres:postgres@host.docker.internal:55322/postgres

# Nur fuer das schlanke lokale Profil ohne Supabase relevant
# (docker compose --profile local-db, siehe docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/finanzplaner

SUPABASE_URL=http://host.docker.internal:55321
# Adresse, unter der ein CLIENT (Handy, Browser auf einem anderen Geraet)
# Supabase erreicht - fuer GET /v1/system/instance-config (Mobile "Eigener
# Server"). Leer = Fallback auf SUPABASE_URL oben (passt nur, wenn Client und
# API dieselbe Adresse erreicht). Fuer Tests auf einem echten Geraet im
# eigenen WLAN: die Rechner-IP setzen, z. B. http://192.168.1.23:55321
# (gleicher Wert wie EXPO_PUBLIC_SUPABASE_URL unten).
SUPABASE_PUBLIC_URL=
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

REDIS_URL=redis://redis:6379/0

# LM Studio, OpenAI-kompatible API. Unter Docker Desktop erreichbar ueber
# host.docker.internal; LM Studio wird nicht oeffentlich exponiert.
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1

# Ein festes Token-Budget je KI-Antwort gibt es nicht mehr (frueher
# AI_MAX_TOKENS): das Antwortbudget jedes Aufrufs ergibt sich aus dem in LM
# Studio GELADENEN Kontextfenster und dem Reserveanteil unter Einstellungen ›
# KI › Kontext und Budget. Auch das Zeitbudget je Anfrage ist dort eine
# Haushaltseinstellung (Vorgabe 120 s im Datenbankschema); die fruehere
# Variable AI_REQUEST_TIMEOUT_SECONDS gibt es nicht mehr.

# Zeitbudget in Sekunden fuer die reine Erreichbarkeitspruefung (GET /models).
# Bewusst kurz, damit der Systemstatus bei nicht laufendem LM Studio schnell
# antwortet, statt mehrere Kandidaten-URLs lange zu blockieren.
AI_DISCOVERY_TIMEOUT_SECONDS=5

# Storage: "supabase" oder "s3" (lokaler S3-kompatibler Speicher, z. B. MinIO)
STORAGE_BACKEND=supabase
S3_ENDPOINT=
S3_BUCKET=finanzplaner
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Worker (services/worker, Dramatiq) ------------------------------------
WORKER_HEARTBEAT_INTERVAL_SECONDS=15

# --- Postgres (nur schlankes lokales Profil, entfaellt bei Supabase) -------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finanzplaner

# --- Caddy (Produktiv/Home-Server) -----------------------------------------
DOMAIN=localhost

# Nur fuer docker-compose.prod.yml (Betriebsprofil "Produktiv/SaaS"):
# ACME_EMAIL ist dort Pflicht (Let's-Encrypt-Ablauf-/Ratenlimit-Warnungen),
# CADDY_ACME_CA optional auf die LE-Staging-CA setzen, um Zertifikate
# ratenlimit-sicher zu testen. Fuer "Privat/Home-Server" (Basisdatei ohne
# Ueberlagerung) bleiben beide ungesetzt.
# ACME_EMAIL=admin@example.com
# CADDY_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# --- Backups (infra/backup/) ------------------------------------------------
# Oeffentlicher age-Empfaengerschluessel fuer backup.sh - siehe
# infra/backup/README.md fuer Schluesselerzeugung.
# AGE_RECIPIENT=age1...

# --- Monitoring (infra/monitoring/, optional) -------------------------------
# Leer/ungesetzt: OpenTelemetry-Instrumentierung ist ein no-op (kein Tracing-
# Overhead ohne Sammler). Nur setzen, wer den optionalen OTel-Collector-
# Overlay nutzt (docker-compose.monitoring.yml) oder einen eigenen Sammler
# betreibt - siehe infra/monitoring/README.md.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
